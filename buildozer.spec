[app]
title = Dementia Care Assistant
package.name = dementiacare
package.domain = org.accessibility.care
source.dir = .
source.include_exts = py,png,jpg,kv,atlas,db
version = 1.0.0
requirements = python3,kivy,opencv,plyer,numpy,pyjnius
android.permissions = CAMERA, VIBRATE, ACCESS_FINE_LOCATION, ACCESS_COARSE_LOCATION, READ_EXTERNAL_STORAGE, WRITE_EXTERNAL_STORAGE, INTERNET
android.api = 33
android.minapi = 21
orientation = portrait
fullscreen = 0
